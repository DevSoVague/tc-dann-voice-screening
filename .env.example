# Local path to Bridge2AI-Voice v3.0.0 (folder containing features/ and phenotype/).
# Requires credentialed PhysioNet access and a signed Bridge2AI-Voice DUA.
B2AI_DATA_ROOT=/path/to/b2ai-voice/3.0.0

# Audit scripts
AUDIT_OUT_DIR=outputs/audit
PREDICTIONS_DIR=/path/to/patient_level_predictions

# SVD external validation (output of svd/svd_preprocess.py)
SVD_OUT_ROOT=/path/to/svd_out

# Serving
TC_DANN_BUNDLE_DIR=tc_dann_results
SESSIONS_DIR=sessions
TC_DANN_API=http://localhost:8000
VOXCLIN_API=http://localhost:8000

# Agentic app (optional)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=papers_rag
AI_GATEWAY_URL=
